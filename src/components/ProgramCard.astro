---
interface Props { category: string; title: string; }
const { category, title } = Astro.props;
---
<article class="card"><p>{category}</p><h3>{title}</h3></article>
<style>
	.card { min-height:20rem; display:flex; flex-direction:column; justify-content:flex-end; gap:.5rem; padding:1.25rem; background:linear-gradient(#0d0d0f,#8c140d); color:#fff; }
	p,h3 { margin:0; text-transform:uppercase; } p { color:var(--brand-red); font-size:.8rem; font-weight:600; } h3 { max-width:11ch; font-family:var(--font-display); font-size:1.85rem; line-height:1; }
	@media (min-width:48rem) { .card { min-height:24.375rem; padding:1.5rem; } h3 { font-size:2.25rem; } }
</style>
