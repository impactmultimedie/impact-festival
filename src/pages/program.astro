---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Program — Impact Festival">
	<Header />
	<main id="main-content" class="page"><p class="eyebrow">PROGRAM 2026</p><h1>Two days.<br />One shared impact.</h1><p class="intro">The program page is ready for schedules, filters and detailed event cards.</p></main>
	<Footer />
</Layout>
<style>
	.page { min-height:65vh; padding:5rem 1.5rem; background:linear-gradient(#10120d,#343c25); color:#fff; } .eyebrow { color:var(--brand-red); font-weight:600; } h1 { margin:.5rem 0 2rem; color:var(--brand-red); font:900 clamp(3rem,10vw,7rem)/.9 var(--font-display); text-transform:uppercase; } .intro { max-width:40rem; font-size:1.25rem; line-height:1.5; }
	@media (min-width:48rem) { .page { padding:7rem 5%; } }
</style>
