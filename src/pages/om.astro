---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Impact Festival">
	<Header />
	<main id="main-content" class="page"><p class="eyebrow">ABOUT</p><h1>Culture that<br />creates impact</h1><p class="intro">This page is ready for the team’s story, purpose and local partnerships.</p></main>
	<Footer />
</Layout>
<style>
	.page { min-height:65vh; padding:5rem 1.5rem; } .eyebrow { color:var(--brand-red); font-weight:600; } h1 { margin:.5rem 0 2rem; font:900 clamp(3rem,10vw,7rem)/.9 var(--font-display); text-transform:uppercase; } .intro { max-width:40rem; font-size:1.25rem; line-height:1.5; }
	@media (min-width:48rem) { .page { padding:7rem 5%; } }
</style>
